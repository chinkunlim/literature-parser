# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env and customize as needed. Never commit actual .env with secrets.
# ==============================================================================

# Ollama Local Service
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Hardware Guard Thresholds
MIN_RAM_AVAILABLE_GB=4.0
MIN_DISK_FREE_GB=10.0
ALLOW_BATTERY_MODE=0

# Git Remote Safety Lock
ALLOW_PUSH=0
