{
  "emergent_sections": [
    {
      "name": "Author Note & Acknowledgments",
      "aliases": ["Author Note", "Author Notes", "Acknowledgments", "Acknowledgement"],
      "patterns": [
        "(?i)^Author Note\\b",
        "(?i)^Correspondence concerning this article\\b",
        "(?i)We thank .*? for their assistance",
        "(?i)This research was supported by"
      ],
      "target_heading_level": 2,
      "typical_location": "end_of_paper_or_page_1"
    },
    {
      "name": "History & Received Dates",
      "aliases": ["Article History", "Dates"],
      "patterns": [
        "(?i)^Received\\s+\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4}",
        "(?i)^Revision received\\s+[A-Za-z]+",
        "(?i)^Accepted\\s+[A-Za-z]+"
      ],
      "target_heading_level": 3,
      "typical_location": "end_of_paper"
    },
    {
      "name": "Funding & Conflict of Interest",
      "aliases": ["Funding", "Conflict of Interest", "Role of the Funding Source"],
      "patterns": [
        "(?i)^Role of the Funding Source\\b",
        "(?i)^Conflict of Interest\\b",
        "(?i)^Financial Disclosure\\b"
      ],
      "target_heading_level": 2,
      "typical_location": "before_references"
    }
  ]
}
